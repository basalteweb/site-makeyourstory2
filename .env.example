# Local: npm ci, puis npm start. Stripe et l'envoi sortant sont fermés par défaut.
APP_MODE=local
APP_URL=http://localhost:3000
PORT=3000
APP_SECRET=
ADMIN_EMAILS=administrateur@example.com
ADMIN_NOTIFY_EMAIL=administrateur@example.com

# PostgreSQL dédié et volume privé. Renseigner en mode production.
DATABASE_URL=
POSTGRES_PASSWORD=
MEDIA_DIR=.runtime/media
MIGRATE=false
TRUST_PROXY_HOPS=0
HOSTING_NAME=

CHECKOUT_ENABLED=false
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
TERMS_VERSION=
DELIVERY_BUSINESS_DAYS=
CONSUMER_MEDIATOR=
CONSUMER_MEDIATOR_URL=
BILLING_VAT_NOTICE=

MAIL_MODE=outbox
RESEND_API_KEY=
MAIL_FROM=
TEST_EMAIL_ALLOWLIST=
